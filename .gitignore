# ==============================================================================
# Git Ignore Rules for Panoramic Depth Estimation
# ==============================================================================

# Data and large datasets
/data/
/dataset/
*.zip
*.tar.gz
*.exr
*.npy
*.npz
!tests/data/**

# Model weights and checkpoints
weights/
**/weights/
*.pth
*.pt
*.bin
*.onnx

# Staging attic for refactored/superseded material
_attic/

# Python, environment & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.vscode/
.idea/
.ipynb_checkpoints/
*.egg-info/
dist/
build/

# Third party clones
third_party/DAP/
