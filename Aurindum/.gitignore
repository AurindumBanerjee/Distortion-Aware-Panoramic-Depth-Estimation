# ==============================================================================
# Git Ignore Rules for Aurindum
# ==============================================================================

# Data and large datasets
data/
**/data/
*.zip
*.tar
*.tgz
**/_dl/
dataset/
**/dataset/
**/datasets_raw/
*.tar.gz
*.exr
*.npy
*.npz

# Model weights and checkpoints
weights/
**/weights/
*.pth
*.pt
*.bin
*.onnx

# Results, heavy predictions, and logs
outputs/
**/outputs/
logs/
**/logs/
results/**/predictions/
results/**/heatmap__*.npy
results/**/qualitative/

# Python, environment & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.vscode/

# Third party clones
third_party/DAP/
outputs_*/
**/outputs_*/
logs_*/
**/logs_*/
third_party/DA2/
third_party/DA360/

# LaTeX build files
*.aux
*.log
*.out
